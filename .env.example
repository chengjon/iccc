# MongoDB Configuration
MONGODB_HOST=192.168.123.104
MONGODB_PORT=27017
MONGODB_USERNAME=mongo
MONGODB_PASSWORD=your_password_here
MONGODB_DBNAME=iccc

# Alternative: Full MongoDB URL (overrides individual settings above)
# MONGODB_URL=mongodb://mongo:your_password_here@192.168.123.104:27017/iccc

# Redis Configuration
REDIS_HOST=192.168.123.104
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=14

# Alternative: Full Redis URL (overrides individual settings above)
# REDIS_URL=redis://192.168.123.104:6379/14

# API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Observability
SQLITE_PATH=./data/events.db
LOG_LEVEL=INFO

# Development
DEBUG=true

# Optional: Custom agent configurations
CLAUDE_AGENTS_DIR=~/.claude/agents
