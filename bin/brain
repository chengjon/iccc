#!/usr/bin/env python3
"""
Brain CLI - 规格驱动开发命令行工具
"""

import sys
import os
from pathlib import Path

# 添加项目路径到Python路径
project_root = Path(__file__).parent.parent
sys.path.insert(0, str(project_root))

from brain.workflow_engine import BrainWorkflowEngine
import asyncio


def main():
    """主函数"""
    import argparse

    parser = argparse.ArgumentParser(
        description='Brain - 规格驱动开发工作流引擎',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
示例:
  # 基本用法
  brain --init

  # 分析需求并生成规格文档
  brain --analyze --docs README.md CLAUDE.md

  # 带用户需求的分析
  brain --analyze --docs README.md --request "添加用户认证功能"

  # 使用特定工作流
  brain --analyze --workflow bug_fix --docs BUG_REPORT.md
        """
    )

    parser.add_argument(
        '--init',
        action='store_true',
        help='初始化Brain工作目录'
    )

    parser.add_argument(
        '--analyze',
        action='store_true',
        help='分析需求并生成规格文档'
    )

    parser.add_argument(
        '--docs',
        nargs='+',
        default=['README.md', 'CLAUDE.md'],
        help='输入文档列表'
    )

    parser.add_argument(
        '--request',
        help='额外的用户需求描述'
    )

    parser.add_argument(
        '--workflow',
        choices=['feature_development', 'bug_fix', 'refactoring'],
        default='feature_development',
        help='工作流类型'
    )

    parser.add_argument(
        '--project-root',
        type=Path,
        default=Path.cwd(),
        help='项目根目录路径'
    )

    args = parser.parse_args()

    # 如果没有指定参数，显示帮助
    if len(sys.argv) == 1:
        parser.print_help()
        return

    # 初始化工作目录
    if args.init:
        iccc_dir = args.project_root / '.iccc'
        plans_dir = iccc_dir / '.plans' / 'current'
        plans_dir.mkdir(parents=True, exist_ok=True)
        print(f"✅ Brain工作目录已初始化: {plans_dir}")

    # 执行需求分析
    if args.analyze:
        async def run_analysis():
            engine = BrainWorkflowEngine(args.project_root)
            results = await engine.run_workflow(
                input_docs=args.docs,
                user_request=args.request,
                workflow_type=args.workflow
            )

            # 显示后续步骤建议
            print("\n📌 后续步骤建议:")
            print("1. 查看生成的IDEAS.md，确认需求理解正确")
            print("2. 检查INSTITUTION.md中的技术规范")
            print("3. 根据MAINTASK.md开始分配任务")
            print("4. 运行: iccc assign --task TASK-001 --agent worker-frontend")

        asyncio.run(run_analysis())


if __name__ == '__main__':
    main()